# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (secret stays server-side)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used to hash checkout IPs for abuse throttling. Generate a long random value.
CHECKOUT_RATE_LIMIT_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Divine Mee <orders@divinemee.com>

# Canonical public URL, without a trailing slash.
# Vercel currently redirects the apex domain to www.
NEXT_PUBLIC_APP_URL=https://www.divinemee.com
